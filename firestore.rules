rules_version = '2';

// Regras de segurança do Família Segura.
// Publique com: firebase deploy --only firestore:rules,firestore:indexes
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function circleData(cid) {
      return get(/databases/$(database)/documents/circles/$(cid)).data;
    }

    function isMember(cid) {
      return signedIn() && request.auth.uid in circleData(cid).members;
    }

    function validLatLng(d) {
      return d.lat is number && d.lng is number
        && d.lat >= -90 && d.lat <= 90
        && d.lng >= -180 && d.lng <= 180;
    }

    // Perfil do usuário: só o próprio dono lê e escreve.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Código de convite -> id do círculo.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.circleId is string
        && getAfter(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /circles/{cid} {
      // O id do círculo é aleatório e só é obtido pelo código de convite.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn() && (
        // Dono: pode renomear e remover membros, mas não trocar o dono nem o código.
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.auth.uid in request.resource.data.members)
        ||
        // Quem tem o convite: só pode se adicionar.
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet()))
        ||
        // Membro comum: só pode sair.
        (request.auth.uid in resource.data.members
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Última localização de cada membro.
      match /locations/{uid} {
        allow read: if isMember(cid);
        allow create, update: if isMember(cid) && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || circleData(cid).ownerId == request.auth.uid);
      }

      // Trajeto (histórico).
      match /history/{hid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && request.resource.data.uid == request.auth.uid
          && validLatLng(request.resource.data);
        allow update: if false;
        allow delete: if isMember(cid) && resource.data.uid == request.auth.uid;
      }

      // Lugares (cercas virtuais).
      match /places/{pid} {
        allow read: if isMember(cid);
        allow create, update: if isMember(cid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.radius is number
          && request.resource.data.radius >= 50
          && request.resource.data.radius <= 2000
          && validLatLng(request.resource.data);
        allow delete: if isMember(cid);
      }

      // Alertas: chegada, saída e SOS.
      match /events/{eid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['arrive', 'leave', 'sos'];
        allow update, delete: if false;
      }
    }

    // Link temporário de localização (público enquanto não expira).
    match /shares/{token} {
      allow get: if resource.data.expiresAt > request.time
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.expiresAt == resource.data.expiresAt;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
